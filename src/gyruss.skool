;
; Used by the routine at #R$90D6.
;
; Upload patterns
c$84CB LD D,$00      ;
 $84CD LD E,(HL)     ; DE = start index
 $84CE INC HL        ;
 $84CF LD C,(HL)     ;
 $84D0 LD B,$00      ; BC = count
 $84D2 PUSH BC       ;
 $84D3 POP IY        ; IY = count
 $84D5 INC HL        ; HL now points to graphics data
 $84D6 LD A,$03      ; Table code (3 = pattern generator table)
 $84D8 JP $1FBE      ; PUT_VRAM

; Get stage data address
