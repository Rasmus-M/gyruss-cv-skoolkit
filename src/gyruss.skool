; Routine at A2BB
;
; Used by the routine at #R$9B99.
c$A2BB LD A,$9F      ; Mute channel 1
 $A2BD LD C,$90      ;
 $A2BF LD D,$80      ;
 $A2C1 LD IX,($7272) ;
 $A2C5 CALL $A314    ;
 $A2C8 LD A,$BF      ; Mute channel 2
 $A2CA LD C,$B0      ;
 $A2CC LD D,$A0      ;
 $A2CE LD IX,($7274) ;
 $A2D2 CALL $A314    ;
 $A2D5 LD A,$DF      ; Mute channel 3
 $A2D7 LD C,$D0      ;
 $A2D9 LD D,$C0      ;
 $A2DB LD IX,($7276) ;
 $A2DF CALL $A314    ;
 $A2E2 LD A,$FF      ; Mute channel 4
 $A2E4 LD C,$F0      ;
 $A2E6 LD IX,($7270) ;
 $A2EA LD E,(IX+$00) ;
 $A2ED INC E         ;
 $A2EE JR NZ,$A2F3   ;
 $A2F0 OUT ($FF),A   ;
 $A2F2 RET           ;

; Routine at A2F3
;
; Used by the routine at #R$A2BB.
c$A2F3 CALL $A303    ;
 $A2F6 LD A,(IX+$04) ;
 $A2F9 AND $0F       ;
 $A2FB LD HL,$7278   ;
 $A2FE CP (HL)       ;
 $A2FF RET Z         ;
 $A300 LD (HL),A     ;
 $A301 LD C,$E0      ;
; This entry point is used by the routine at #R$A31D.
*$A303 LD A,(IX+$04) ;
 $A306 BIT 4,C       ;
 $A308 JR Z,$A30E    ;
 $A30A RRCA          ;
 $A30B RRCA          ;
 $A30C RRCA          ;
 $A30D RRCA          ;
*$A30E AND $0F       ;
 $A310 OR C          ;
 $A311 OUT ($FF),A   ;
 $A313 RET           ;

; Send sound data to PSG
;
; Used by the routine at #R$A2BB.
;
; I:A
; I:C
; I:D
; I:IX
@label=output_sound
c$A314 LD E,(IX+$00) ;
 $A317 INC E         ;
 $A318 JR NZ,$A31D   ;
 $A31A OUT ($FF),A   ;
 $A31C RET           ;

; Routine at A31D
;
; Used by the routine at #R$A314.
c$A31D CALL $A303    ;
 $A320 LD A,(IX+$03) ;
 $A323 AND $0F       ;
 $A325 OR D          ;
 $A326 OUT ($FF),A   ;
 $A328 LD A,(IX+$03) ;
 $A32B AND $F0       ;
 $A32D LD D,A        ;
 $A32E LD A,(IX+$04) ;
 $A331 AND $0F       ;
 $A333 OR D          ;
 $A334 RRCA          ;
 $A335 RRCA          ;
 $A336 RRCA          ;
 $A337 RRCA          ;
 $A338 OUT ($FF),A   ;
 $A33A RET           ;

; Routine at A33B
;
; Used by the routine at #R$82BF.
@label=initial_game_loop
c$A33B LD HL,$80B5     ; New center of projection at bottom center for
                       ; implosion
 $A33E LD ($72C5),HL   ; Set #R$72C5, which will be copied to #R$7000
 $A341 LD HL,$71EB     ; Status flags
 $A344 SET 4,(HL)      ; Set bit 4
; Allocate 6 dot sprites for the implosion that becomes the ship
 $A346 LD IY,$A4B2     ; Sprite init data
 $A34A LD B,$06        ; Allocate 6 sprites
*$A34C RST $28         ; Allocate sprite
 $A34D LD (IX+$00),$0D ; Sprite type is $0D (a dot)
 $A351 LD (IX+$01),$00 ; Polar y
 $A355 LD (IX+$02),$00 ; Polar x
 $A359 RST $30         ; Load sprite pattern
 $A35A LD (IX+$01),$16 ; Polar y
 $A35E LD A,(IY+$00)   ; Get init data
 $A361 LD (IX+$02),A   ; Polar x
 $A364 LD (IX+$0B),$09 ; Set color (pink)
 $A368 INC IY          ; Next init data
 $A36A DJNZ $A34C      ; Loop for 6 sprites
; Display implosion
 $A36C LD B,$14        ; 20
*$A36E PUSH BC         ; Save counter
 $A36F CALL $A471      ; Move dots
 $A372 CALL $A73C      ; Control ship
 $A375 CALL $ACF9      ; Upload sprite data
 $A378 HALT            ; Wait interrupt
 $A379 CALL $AFFF      ;
 $A37C CALL $AB72      ; Display center enemies
 $A37F POP BC          ; Restore counter
 $A380 DJNZ $A36E      ; Loop 20 times
; Allocate ship etc.
 $A382 CALL $ACDF      ;
 $A385 RST $28         ; Allocate sprite
 $A386 LD (IX+$00),$00 ; Sprite type $01 (ship 1)
 $A38A LD (IX+$01),$00 ; Polar y
 $A38E LD (IX+$02),$00 ; Polar x
 $A392 LD (IX+$0B),$06 ; Set color (red)
 $A396 RST $30         ; Load sprite pattern
 $A397 RST $28         ; Allocate sprite
 $A398 LD (IX+$00),$01 ; Sprite type $01 (ship 2)
 $A39C LD (IX+$01),$00 ; Polar y
 $A3A0 LD (IX+$02),$00 ; Polar x
 $A3A4 LD (IX+$0B),$04 ; Set color (blue)
 $A3A8 RST $30         ; Load sprite pattern
 $A3A9 CALL $A808      ; Display ship background patterns
 $A3AC CALL $ACF9      ; Upload sprite data
 $A3AF LD A,$07        ;
 $A3B1 CALL $9EA3      ;
; Game loop 60 times
 $A3B4 LD B,$3C        ; 60
*$A3B6 HALT            ; Wait interrupt
 $A3B7 PUSH BC         ; Save counter
 $A3B8 CALL $AFFF      ; Display stars
 $A3BB CALL $A73C      ; Control ship
 $A3BE CALL $AB72      ; Display center enemies
 $A3C1 CALL $84B1      ; Upload sprites
 $A3C4 POP BC          ; Restore counter
 $A3C5 DJNZ $A3B6      ; Loop 60 times
 $A3C7 LD HL,$1A00     ; Clear warps line
 $A3CA LD DE,$0020     ; ...
 $A3CD XOR A           ; ...
 $A3CE CALL $1F82      ; FILL_VRAM
 $A3D1 LD A,($71EB)    ; Status
 $A3D4 BIT 7,A         ; Check bit for 2 players
 $A3D6 RET Z           ; Return if not
 $A3D7 LD HL,$192C     ; Clear player message
 $A3DA LD DE,$0008     ; ...
 $A3DD XOR A           ; ...
 $A3DE JP $1F82        ; FILL_VRAM and return

; Routine at A3E1
;
; Used by the routine at #R$8139.
@label=explode
c$A3E1 LD A,$2A        ;
 $A3E3 LD ($7003),A    ;
 $A3E6 CALL $A808      ; Display ship background patterns
 $A3E9 LD A,$7F        ; Not allocated
 $A3EB LD ($7002),A    ; 1st sprite
 $A3EE LD ($700E),A    ; 2nd sprite
 $A3F1 LD A,($7253)    ; Active shots
 $A3F4 OR A            ; If zero
 $A3F5 JR Z,$A413      ; Then skip ahead
; Deallocate all shots
 $A3F7 LD IX,$7002     ; Sprite data table
 $A3FB LD DE,$000C     ; Size of each sprite
 $A3FE LD B,$20        ; 32 sprites
 $A400 LD A,$02        ; Is it type $02 (shot)?
*$A402 CP (IX+$00)     ; ...
 $A405 JR NZ,$A40F     ; No, then skip
 $A407 LD (IX+$00),$7F ; Set as not allocated
 $A40B LD (IX+$08),$F8 ; Set y
*$A40F ADD IX,DE       ; Next sprite
 $A411 DJNZ $A402      ; Loop 32 times
; Set center of projection for explosion
*$A413 LD HL,($700A)   ; Y and X of 1st sprite
 $A416 LD BC,$0404     ; Add 4 to each
 $A419 ADD HL,BC       ; ...
 $A41A LD ($72C5),HL   ; Save it in #R$72C5, which will be copied to #R$7000
 $A41D LD A,($7004)    ; Byte 2 of 1st sprite
 $A420 LD ($72C7),A    ; Save it temporary
; Allocate 6 sprites for explosion
 $A423 LD IY,$A4B8     ;
 $A427 LD B,$06        ; Allocate 6 sprites
*$A429 RST $28         ; Allocate sprite
 $A42A LD (IX+$00),$0D ; Sprite type is $0D (a dot)
 $A42E LD (IX+$01),$00 ; Polar y
 $A432 LD (IX+$02),$00 ; Polar x
 $A436 LD (IX+$0B),$09 ; Set color (pink)
 $A43A RST $30         ; Load sprite pattern
 $A43B LD A,($72C7)    ; Restore byte 2 of 1st sprite
 $A43E ADD A,(IY+$00)  ; Add data from table
 $A441 AND $3F         ; Mod $40
 $A443 LD (IX+$02),A   ; Set polar x on new sprite
 $A446 LD (IX+$01),$2A ; Set polar y
 $A44A INC IY          ; Next init data
 $A44C DJNZ $A429      ; Loop for 6 sprites
; Game loop for 3 seconds
 $A44E LD B,$14        ; 20
*$A450 PUSH BC         ; Outer loop
 $A451 CALL $A471      ; Move dots
 $A454 CALL $ACF9      ; Upload sprite data
 $A457 LD B,$09        ; 9
*$A459 HALT            ; Inner loop
 $A45A PUSH BC         ;
 $A45B CALL $AFFF      ; Display stars
 $A45E CALL $85E6      ;
 $A461 CALL $AB72      ; Display center enemies
 $A464 CALL $8E2D      ;
 $A467 CALL $84B1      ; Upload sprites
 $A46A POP BC          ;
 $A46B DJNZ $A459      ; Loop 9 times
 $A46D POP BC          ;
 $A46E DJNZ $A450      ; Loop 20 times
 $A470 RET             ;

; Routine at A471
;
; Change polar y of sprite types $0D, according to bit 2 of #R$71EB. Used by
; the routines at #R$A33B and #R$A3E1.
@label=move_dots
c$A471 LD HL,($72C5) ; Copy #R$72C5 to #R$7000
 $A474 LD ($7000),HL ; ...
 $A477 LD B,$20      ; 32 sprites
 $A479 LD IX,$7002   ; Sprite data
; This entry point is used by the routine at #R$A4A0.
*$A47D LD A,(IX+$00) ; Get type
 $A480 CP $0D        ; Is it $0D (a dot)?
 $A482 JR NZ,$A4A4   ; If not then move to next sprite
 $A484 PUSH BC       ; Save counter
 $A485 LD D,(IX+$01) ; Polar y
 $A488 LD E,(IX+$02) ; Polar x
 $A48B CALL $B1C6    ; Polar to screen
 $A48E LD (IX+$08),D ; Set y
 $A491 LD (IX+$09),E ; Set x
 $A494 LD A,($71EB)  ; Status
 $A497 BIT 2,A       ; Test bit
 $A499 JR NZ,$A4A0   ; If 1, decrement polar y
 $A49B INC (IX+$01)  ; Else increment polar y
 $A49E JR $A4A3      ; Skip next
*$A4A0 DEC (IX+$01)  ; Decrement polar y
*$A4A3 POP BC        ; Restore counter
*$A4A4 LD DE,$000C   ; Size of each sprite
 $A4A7 ADD IX,DE     ; Next sprite
 $A4A9 DJNZ $A47D    ; Loop 32 times
 $A4AB LD HL,$8060   ; Set #R$7000 back to original value
 $A4AE LD ($7000),HL ; ...
 $A4B1 RET           ;

