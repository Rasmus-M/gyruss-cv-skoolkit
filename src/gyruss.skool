 $9163 LD BC,$01E0   ; Display on, interrupt on
 $9166 RST $18       ; WRITE_REGISTER
@label=start_screen_loop
*$9167 HALT          ; Wait for interrupt
 $9168 CALL $AFFF    ; Draw stars
 $916B CALL $AE94    ;
