; Update sprite types $0F - $11
;
; Used by the routine at #R$8139.
c$8AE6 LD IX,$7002     ; Sprite data
 $8AEA LD DE,$000C     ; Size of each sprite
 $8AED LD B,$20        ; 32 sprites
*$8AEF LD A,(IX+$00)   ; Get type
 $8AF2 CP $0E          ; If < 14 then move on
 $8AF4 JR C,$8B0D      ; ...
 $8AF6 CP $12          ; If >= 18 then move on
 $8AF8 JR NC,$8B0D     ; ...
 $8AFA BIT 6,(IX+$07)  ; For types $0F - $11, test bit 6 of ?
 $8AFE JR NZ,$8B0D     ; If not set, move on
 $8B00 LD (IX+$00),$10 ; Set type to $10
 $8B04 LD (IX+$07),$0C ; Set ? to $0C
 $8B08 LD (IX+$04),$FF ; Set ? to $FF
 $8B0C RST $30         ; Load sprite pattern
*$8B0D ADD IX,DE       ; Next sprite
 $8B0F DJNZ $8AEF      ; Loop for 32 sprites
 $8B11 RET             ;

; Draw background patterns for sprite
;
; Used by the routines at #R$8F0F, #R$8F55, #R$99D3, #R$9A75 and #R$A808.
;
; I:IY Data structure
@label=display_background_patterns
c$8B12 LD L,(IY+$02)   ; Get name table address of 3 x 3 area to clear
 $8B15 LD H,(IY+$03)   ; ...
 $8B18 LD A,H          ; If zero
 $8B19 OR L            ; ...
 $8B1A JR Z,$8B2D      ; Then skip ahead
; Clear name table area
 $8B1C LD C,$03        ; 3 rows
*$8B1E EX DE,HL        ; DE now VDP address
 $8B1F LD B,$03        ; 3 columns
 $8B21 XOR A           ; Zero to clear
*$8B22 RST $10         ; Write VDP byte
 $8B23 INC DE          ; Next VDP address
 $8B24 DJNZ $8B22      ; Inner loop
 $8B26 LD HL,$001D     ; One row down and 3 columns back
 $8B29 ADD HL,DE       ; ...
 $8B2A DEC C           ; Row counter
 $8B2B JR NZ,$8B1E     ; Outer loop
