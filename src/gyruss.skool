; Display score
;
; Used by the routines at #R$8024, #R$80E8 and #R$846B.
;
; I:A Player 0 or 1
@label=display_score
c$A699 LD IX,$71F3   ; Score player 1
 $A69D LD E,$04      ; Offset into name table player 1
 $A69F OR A          ; If it player 1
 $A6A0 JR Z,$A6A8    ; The skip ahead
 $A6A2 LD IX,$71F9   ; Score player 2
 $A6A6 LD E,$18      ; Offset into name table player 2
*$A6A8 LD D,$18      ; MSB of name table in VDP
 $A6AA LD BC,$0300   ; B = 3 (digits), C = 0 (zero character offset)
*$A6AD LD A,(IX+$02) ; Get 3rd score byte (most significant)
 $A6B0 RRA           ; Shift BCD digit into place
 $A6B1 RRA           ; ...
 $A6B2 RRA           ; ...
 $A6B3 RRA           ; ...
 $A6B4 CALL $A6C8    ; Display most significant digit
 $A6B7 DEC B         ; If B > 1
 $A6B8 JR NZ,$A6BC   ; Then don't choose new zero character offset
 $A6BA LD C,$30      ; Else choose ASCII 0 as zero character offset
*$A6BC INC B         ; Increment again
 $A6BD LD A,(IX+$02) ; Get 3rd score byte (most significant)
 $A6C0 CALL $A6C8    ; Display least significant digit
 $A6C3 DEC IX        ; Proceed to less significant score bytes
 $A6C5 DJNZ $A6AD    ; Loop 3 times
 $A6C7 RET           ;

; Display digit
;
; Used by the routine at #R$A699.
;
; I:A Digit 0 - 9
@label=display_digit
c$A6C8 AND $0F       ; Isolate BCD digit
 $A6CA JR Z,$A6CE    ; If zero, skip displaying leading zeros by not setting C
 $A6CC LD C,$30      ; Use ASCII 0 as zero character offset by default
*$A6CE OR C          ; Add zero character offset
 $A6CF RST $10       ; Write VDP byte
 $A6D0 INC DE        ; Next VDP address
 $A6D1 RET           ;

; Display lives
;
; Used by the routines at #R$82BF and #R$A6EC.
@label=display-lives
c$A6D2 LD HL,$1AE2   ; VDP address of 'lives'
 $A6D5 LD DE,$0009   ; Count
 $A6D8 XOR A         ; Value
 $A6D9 CALL $1F82    ; FILL_VRAM
 $A6DC LD A,($71FF)  ; Get lives
 $A6DF DEC A         ; Display one less live
 $A6E0 RET Z         ; Return if none to display
 $A6E1 LD B,A        ; Count
 $A6E2 LD DE,$1AE2   ; VDP address
 $A6E5 LD A,$21      ; Ship character
*$A6E7 RST $10       ; Write VDP byte
 $A6E8 INC DE        ; Next VDP address
 $A6E9 DJNZ $A6E7    ; Loop
 $A6EB RET           ;

; Add points to score
;
; Used by the routines at #R$846B and #R$9978.
;
; I: HL Points to add (BCD)
@label=add_score
c$A6EC PUSH DE       ;
 $A6ED PUSH BC       ;
 $A6EE LD ($72C8),HL ; Save points to add (this buffer has one more byte)
 $A6F1 LD A,($71F1)  ; Current player
 $A6F4 LD DE,$71F3   ; Score player 1
 $A6F7 OR A          ; Is it player 1?
 $A6F8 JR Z,$A6FD    ; The skip ahead
 $A6FA LD DE,$71F9   ; Score player 2
*$A6FD PUSH DE       ; Save pointer to score
 $A6FE LD HL,$72C8   ; Pointer to points to add
 $A701 LD B,$03      ; 3 bytes in score
*$A703 LD A,(DE)     ; Get score byte
 $A704 ADC A,(HL)    ; Add points
 $A705 DAA           ; Adjust for BCD
 $A706 LD (DE),A     ; Store score byte
 $A707 INC DE        ; Next score byte
 $A708 INC HL        ; Next points byte
 $A709 DJNZ $A703    ; Loop 3 times
 $A70B POP DE        ; Restore pointer to score
 $A70C INC DE        ; Advance to last byte of extra life score $71F5 or $71FB
 $A70D INC DE        ; ...
 $A70E LD HL,$0003   ; Point HL to byte at #R$71F8 or #R$71FE (initially set to 6)
 $A711 ADD HL,DE     ; ...
 $A712 PUSH HL       ; Save pointer
 $A713 LD B,$03      ; 3 bytes to check
*$A715 LD A,(DE)     ; Get score byte
 $A716 CP (HL)       ; Compare with extra life byte
 $A717 JR NZ,$A71E   ; Exit loop if not equal
 $A719 DEC DE        ; Previous score byte
 $A71A DEC HL        ; Previous extra life byte
 $A71B DJNZ $A715    ; Loop 3 times
 $A71D XOR A         ; All equal, set A = 0
*$A71E POP HL        ; Restore pointer to #R$71F8 or #R$71FE
 $A71F JR C,$A739    ; Return if extra life byte was bigger
 $A721 LD A,(HL)     ; Next extra life at 80000 more points
 $A722 ADD A,$08     ; ...
 $A724 DAA           ; ...
 $A725 LD (HL),A     ; ...
 $A726 LD A,($71FF)  ; Get lives
 $A729 CP $09        ; Return if already 9
 $A72B JR NC,$A739   ; ...
 $A72D INC A         ; Extra life
 $A72E LD ($71FF),A  ; Save it
 $A731 CALL $A6D2    ; Display lives
 $A734 LD A,$06      ; Play a sound
 $A736 CALL $9EA3    ; ...
*$A739 POP BC        ;
 $A73A POP DE        ;
 $A73B RET           ;

; Control ship
;
; Control ship movement and fire using controllers Used by the routines at
; #R$8024, #R$832A, #R$8368, #R$846B and #R$A33B.
@label=control_ship
c$A73C LD A,($71F2)    ; Get frame
 $A73F AND $01         ; Test bit 0
 $A741 RET NZ          ; Return every 2nd frame
 $A742 LD HL,($71F0)   ; Controller: #R$71F1
 $A745 LD L,$00        ; Segment 0
 $A747 CALL $1F79      ; DECODER (H = fire, L = joystick (bit 0: up, bit 1:
                       ; right, bit 2: down, bit 3: left))
 $A74A LD H,$00        ; Reset fire
 $A74C LD DE,$A865     ; Movement table
 $A74F ADD HL,DE       ; Add joystick result (0 - 12, some values not possible)
 $A750 LD IX,$7002     ; Sprite 0 data (ship)
 $A754 LD B,$01        ; Direction = 1 (clockwise)
 $A756 LD A,(HL)       ; Get table value, which is the value of polar x to move
                       ; towards
 $A757 CP $FF          ; Is it an impossible joystick value, e.g. up + down?
 $A759 JR Z,$A781      ; Then skip ahead
 $A75B SUB (IX+$02)    ; Table value - polar x
 $A75E JR Z,$A781      ; If zero the skip ahead (alredy there)
 $A760 JR NC,$A766     ; If positive skip ahead
 $A762 LD B,$FF        ; Direction = -1 (anti-clockwise)
 $A764 NEG             ; abs(value - polar x)
*$A766 CP $21          ; Is the difference < 33?
 $A768 LD A,B          ; Direction
 $A769 JR C,$A76D      ; The skip ahead
 $A76B NEG             ; Otherwise reverse direction
*$A76D ADD A,(IX+$02)  ; Polar x + direction
 $A770 AND $3F         ; Mod 64
 $A772 LD (IX+$02),A   ; Update polar x
 $A775 LD (IX+$0E),A   ; Also update sprite 1
 $A778 RST $30         ; Load sprite pattern sprite 0
 $A779 LD IX,$700E     ; Sprite 1
 $A77D RST $30         ; Load sprite pattern sprite 1
 $A77E CALL $A808      ; Display ship background patterns
; Handle fire
*$A781 LD A,($71EB)    ;
 $A784 BIT 4,A         ;
 $A786 RET NZ          ;
 $A787 LD HL,($71F0)   ; Controller: #R$71F1
 $A78A PUSH HL         ; Save current player
 $A78B LD L,$00        ; Segment 0
 $A78D CALL $1F79      ; DECODER (H = fire, L = joystick)
 $A790 LD A,H          ; Fire
 $A791 POP HL          ; Restore current player
 $A792 PUSH AF         ; Save fire segment 0
 $A793 LD L,$01        ; Segment 1
 $A795 CALL $1F79      ; DECODER
 $A798 POP AF          ; Restore fire segment 0
 $A799 OR H            ; Combine with fire segment 1
 $A79A LD HL,$7256     ; Flags
 $A79D BIT 6,A         ; Test fire pressed
 $A79F JR Z,$A805      ; If not, clear bit for fire pressed, and return
 $A7A1 BIT 0,(HL)      ; Check if fire was pressed last time
 $A7A3 RET NZ          ; Then return (must release after each shot)
 $A7A4 LD A,($7253)    ; Get number of active shots
 $A7A7 BIT 1,(HL)      ; Test for double shot
 $A7A9 JR Z,$A7AD      ; Skip ahead if single shot
 $A7AB SRL A           ; Divide by 2 (allow twice as many shots)
*$A7AD CP $02          ; Return if >= 2
 $A7AF RET NC          ; ...
 $A7B0 LD A,$00        ; No effect
 $A7B2 NOP             ; Some instructions removed here?
 $A7B3 NOP             ; ...
 $A7B4 NOP             ; ...
 $A7B5 LD A,($7253)    ; Increment number of active shots
 $A7B8 INC A           ; ...
 $A7B9 LD ($7253),A    ; ...
 $A7BC SET 0,(HL)      ; Set bit for fire pressed
 $A7BE BIT 1,(HL)      ; Test for double shot
 $A7C0 JR NZ,$A7D5     ; Jump for double shot
 $A7C2 RST $28         ; Allocate sprite
 $A7C3 LD HL,($7003)   ; Ship's polar coordinates
 $A7C6 LD (IX+$01),L   ; Shot y = ship y
 $A7C9 LD (IX+$02),H   ; Shot x = ship x
 $A7CC LD (IX+$00),$02 ; Shot type
 $A7D0 LD (IX+$0B),$0A ; Set color
 $A7D4 RET             ; Return

; Routine at A7D5
;
; Used by the routine at #R$A73C.
c$A7D5 RST $28         ; Allocate sprite
 $A7D6 LD HL,($7003)   ; Ship's polar coordinates
 $A7D9 PUSH HL         ; Save them
 $A7DA LD (IX+$01),L   ; Set polar y same as ship's
 $A7DD LD A,H          ; Ship's polar x
 $A7DE INC A           ; One step clockwise
 $A7DF AND $3F         ; Mod 64
 $A7E1 LD (IX+$02),A   ; Set polar x
 $A7E4 LD (IX+$00),$02 ; Shot type
 $A7E8 LD (IX+$0B),$0A ; Set color (yellow)
 $A7EC RST $28         ; Allocate sprite
 $A7ED POP HL          ; Restore ship's polar coordinates
 $A7EE LD (IX+$01),L   ; Set polar y same as ship's
 $A7F1 LD A,H          ; Ship's polar x
 $A7F2 DEC A           ; One step anti-clockwise
 $A7F3 AND $3F         ; Mod 64
 $A7F5 LD (IX+$02),A   ; Set polar x
 $A7F8 LD (IX+$00),$02 ; Shot type
 $A7FC LD (IX+$0B),$0A ; Set color (yellow)
 $A800 LD HL,$7253     ; Increment number of active shots
 $A803 INC (HL)        ; ...
 $A804 RET             ; Return

; Routine at A805
;
; Used by the routine at #R$A73C.
c$A805 RES 0,(HL)    ; Clear bit for fire pressed
 $A807 RET           ; Return

; Routine at A808
;
; Used by the routines at #R$8368, #R$A33B, #R$A3E1 and #R$A73C.
@label=display_ship_background_patterns
c$A808 PUSH HL         ;
 $A809 PUSH DE         ;
 $A80A PUSH BC         ;
 $A80B PUSH IX         ;
 $A80D PUSH IY         ;
 $A80F LD IY,$722E     ; Buffer for generated structure
 $A813 LD (IY+$06),$18 ;
 $A817 LD (IY+$04),$00 ; Pattern address LSB
 $A81B LD (IY+$05),$00 ; Pattern address MSB
 $A81F LD A,($7003)    ; Ship's polar y
 $A822 CP $15          ;
 $A824 JR NC,$A85A     ; Jump if >= 21
 $A826 LD A,($7004)    ; Ship's polar x
 $A829 ADD A,$02       ; Polar x + 2
 $A82B RRCA            ; Rotate right 3 times
 $A82C RRCA            ; 00XXXXXX -> XXX00XXX
 $A82D RRCA            ;
 $A82E AND $06         ; XXX00XXX -> 00000XX0 (quadrant)
 $A830 LD HL,$A875     ; Adjustment table
 $A833 RST $08         ; Add A to HL
 $A834 LD A,($700B)    ; Ship's screen x
 $A837 ADD A,(HL)      ; Add table value
 $A838 LD (IY+$00),A   ; Store x
 $A83B INC HL          ; Next table address
 $A83C LD A,($700A)    ; Ship's screen y
 $A83F ADD A,(HL)      ; Add table value
 $A840 LD (IY+$01),A   ; Store y
 $A843 LD A,($7004)    ; Ship's polar x
 $A846 ADD A,$02       ; Polar x + 2
 $A848 AND $3C         ; Keep 4 most significant bits, i.e. 16 offsets 4 bytes
                       ; apart
 $A84A LD L,A          ; HL = A
 $A84B LD H,$00        ; ...
 $A84D ADD HL,HL       ; x2
 $A84E ADD HL,HL       ; x4
 $A84F ADD HL,HL       ; x8, now 32 bytes apart
 $A850 LD DE,$A87D     ; Table of ship background patterns (32 bytes per frame)
 $A853 ADD HL,DE       ; Add to offset
 $A854 LD (IY+$04),L   ; Save LSB
 $A857 LD (IY+$05),H   ; Save MSB
*$A85A CALL $8B12      ; Display background patterns
 $A85D POP IY          ;
 $A85F POP IX          ;
 $A861 POP BC          ;
 $A862 POP DE          ;
 $A863 POP HL          ;
 $A864 RET             ;

