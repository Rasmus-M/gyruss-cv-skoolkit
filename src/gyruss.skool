 $ABB7 LD ($72D0),HL ;
 $ABBA LD DE,$0080   ;
 $ABBD XOR A         ;
 $ABBE CALL $1F82    ; FILL_VRAM
 $ABC1 LD A,($72CD)  ;
*$ABC4 LD C,A        ;
 $ABC5 LD B,$00      ;
 $ABC7 LD HL,$7207   ;
 $ABCA ADD HL,BC     ;
 $ABCB BIT 7,(HL)    ;
 $ABCD JP NZ,$ABFA   ;
 $ABD0 CALL $AB38    ;
 $ABD3 CALL $B1C6    ;
 $ABD6 PUSH DE       ;
 $ABD7 LD A,(HL)     ;
 $ABD8 RRA           ;
 $ABD9 RRA           ;
 $ABDA AND $0E       ;
 $ABDC LD C,A        ;
 $ABDD LD B,$00      ;
 $ABDF LD HL,$ACCF   ;
 $ABE2 ADD HL,BC     ;
 $ABE3 CALL $AC47    ;
 $ABE6 LD A,(HL)     ;
 $ABE7 OR A          ;
 $ABE8 JR Z,$ABEF    ;
 $ABEA ADD A,E       ;
 $ABEB LD E,A        ;
 $ABEC CALL $AC47    ;
*$ABEF INC HL        ;
 $ABF0 POP DE        ;
 $ABF1 LD A,(HL)     ;
 $ABF2 OR A          ;
 $ABF3 JR Z,$ABFA    ;
 $ABF5 ADD A,D       ;
 $ABF6 LD D,A        ;
 $ABF7 CALL $AC47    ;
*$ABFA LD HL,$72CD   ;
 $ABFD INC (HL)      ;
 $ABFE RET           ;

; Routine at ABFF
;
; Used by the routine at #R$AB72.
c$ABFF LD HL,$72CC   ;
 $AC02 BIT 0,(HL)    ;
 $AC04 RET Z         ;
 $AC05 RES 0,(HL)    ;
 $AC07 LD A,($722B)  ;
 $AC0A OR A          ;
 $AC0B JR Z,$AC32    ;
 $AC0D LD DE,$194E   ;
 $AC10 LD A,($72CF)  ;
 $AC13 LD C,$04      ;
*$AC15 LD B,$04      ;
*$AC17 RST $10       ; Write VDP byte
 $AC18 INC A         ;
 $AC19 INC DE        ;
 $AC1A DJNZ $AC17    ;
 $AC1C LD HL,$001C   ;
 $AC1F ADD HL,DE     ;
 $AC20 EX DE,HL      ;
 $AC21 DEC C         ;
 $AC22 JR NZ,$AC15   ;
 $AC24 LD HL,($72CE) ;
 $AC27 LD A,L        ;
 $AC28 LD L,H        ;
 $AC29 LD H,A        ;
 $AC2A LD ($72CE),HL ;
 $AC2D XOR A         ;
 $AC2E LD ($72CD),A  ;
 $AC31 RET           ;

; Routine at AC32
;
; Used by the routine at #R$ABFF.
c$AC32 LD DE,$194E   ;
 $AC35 XOR A         ;
 $AC36 LD C,$04      ;
*$AC38 LD B,$04      ;
*$AC3A RST $10       ; Write VDP byte
 $AC3B INC DE        ;
 $AC3C DJNZ $AC3A    ;
 $AC3E LD HL,$001C   ;
 $AC41 ADD HL,DE     ;
 $AC42 EX DE,HL      ;
 $AC43 DEC C         ;
 $AC44 JR NZ,$AC38   ;
 $AC46 RET           ;

; Routine at AC47
;
; Used by the routine at #R$AB72.
c$AC47 PUSH HL       ;
 $AC48 LD A,D        ;
 $AC49 SUB $50       ;
 $AC4B SRL A         ;
 $AC4D AND $FC       ;
 $AC4F LD C,A        ;
 $AC50 LD A,E        ;
 $AC51 SUB $70       ;
 $AC53 JR NC,$AC56   ;
 $AC55 XOR A         ;
*$AC56 CP $20        ;
 $AC58 JR C,$AC5C    ;
 $AC5A LD A,$0F      ;
*$AC5C SRL A         ;
 $AC5E SRL A         ;
 $AC60 SRL A         ;
 $AC62 ADD A,C       ;
 $AC63 ADD A,A       ;
 $AC64 ADD A,A       ;
 $AC65 ADD A,A       ;
 $AC66 LD C,A        ;
 $AC67 LD A,D        ;
 $AC68 AND $07       ;
 $AC6A ADD A,C       ;
 $AC6B LD C,A        ;
 $AC6C LD B,$00      ;
 $AC6E LD HL,($72D0) ;
 $AC71 ADD HL,BC     ;
 $AC72 LD A,E        ;
 $AC73 AND $07       ;
 $AC75 LD B,$80      ;
 $AC77 JR Z,$AC7E    ;
*$AC79 SRL B         ;
 $AC7B DEC A         ;
 $AC7C JR NZ,$AC79   ;
*$AC7E EX DE,HL      ;
 $AC7F CALL $9AD0    ;
 $AC82 OR B          ;
 $AC83 RST $10       ;
 $AC84 EX DE,HL      ;
 $AC85 POP HL        ;
 $AC86 RET           ;

; Data block at AC87
b$AC87 DEFB $05,$28,$10,$28,$1A,$28,$25,$28
 $AC8F DEFB $30,$28,$3A,$28,$00,$28,$0A,$28
 $AC97 DEFB $15,$28,$20,$28,$2A,$28,$35,$28
 $AC9F DEFB $05,$26,$10,$26,$1A,$26,$25,$26
 $ACA7 DEFB $30,$26,$3A,$26,$00,$26,$0A,$26
 $ACAF DEFB $15,$26,$20,$26,$2A,$26,$35,$26
 $ACB7 DEFB $05,$24,$10,$24,$1A,$24,$25,$24
 $ACBF DEFB $30,$24,$3A,$24,$00,$24,$0A,$24
 $ACC7 DEFB $15,$24,$20,$24,$2A,$24,$35,$24
 $ACCF DEFB $01,$00,$FF,$01,$00,$FF,$01,$01
 $ACD7 DEFB $01,$00,$FF,$01,$00,$01,$FF,$FF

; Init sprite data
;
; Used by the routines at #R$82BF, #R$90D6 and #R$A33B.
@label=init_sprite_data
c$ACDF LD IX,$7002     ; Address of sprite data
 $ACE3 LD DE,$000C     ; Size of each sprite
 $ACE6 LD B,$20        ; Number of sprites
 $ACE8 XOR A           ;
 $ACE9 LD ($7182),A    ; Number of allocated sprites
*$ACEC LD (IX+$0A),A   ; Set pattern
; This entry point is used by the routine at #R$AC47.
 $ACEF LD (IX+$00),$FF ; Set as unallocated
 $ACF3 INC A           ;
 $ACF4 ADD IX,DE       ; Advance to next sprite
 $ACF6 DJNZ $ACEC      ; Loop for 32 sprites
 $ACF8 RET             ;

; Upload sprite data to VDP
;
; Used by the routines at #R$8368, #R$84B1, #R$90D6, #R$A33B and #R$A3E1.
@label=upload_sprite_data
c$ACF9 LD DE,($73F2) ; VDP address of sprite allocation table?
 $ACFD LD HL,$7182   ; Number of allocated sprites
 $AD00 LD A,(HL)     ; Get
 $AD01 LD B,A        ; Store in B
*$AD02 PUSH BC       ;
 $AD03 INC HL        ; Next allocation
 $AD04 LD A,(HL)     ; Get sprite index
 $AD05 ADD A,A       ; * 2
 $AD06 ADD A,A       ; * 4
 $AD07 LD C,A        ;
 $AD08 ADD A,A       ; * 8
 $AD09 ADD A,C       ; * 12 (may overflow?)
 $AD0A PUSH HL       ;
 $AD0B LD HL,$700A   ; First y address in sprite data table
 $AD0E RST $08       ; Add A to HL
 $AD0F LD BC,$0004   ; Write 4 bytes for each sprite
 $AD12 PUSH DE       ;
 $AD13 CALL $1FDF    ; WRITE_VRAM
 $AD16 POP HL        ;
 $AD17 LD BC,$0004   ; Add 4 to destination
 $AD1A ADD HL,BC     ;
 $AD1B EX DE,HL      ;
 $AD1C POP HL        ;
 $AD1D POP BC        ;
 $AD1E DJNZ $AD02    ; Loop for each sprite
 $AD20 LD A,$D0      ; End marker byte
 $AD22 RST $10       ; Write VDP byte
 $AD23 LD A,($7182)  ; Get number of allocation sprites
 $AD26 CP $05        ; Is it < 5
 $AD28 RET C         ; Then return
; Rotate sprite allocation table
 $AD29 SUB $04       ;
 $AD2B LD C,A        ; Number of sprites above 4
 $AD2C LD B,$00      ;
 $AD2E PUSH BC       ;
 $AD2F LD HL,$7185   ; From 2nd entry of allocation table
 $AD32 LD DE,$71A3   ; To buffer
 $AD35 LD BC,$0002   ; Copy 2 bytes
 $AD38 LDIR          ;
 $AD3A LD DE,$7185   ; From 4th to 2nd entry of allocation table
 $AD3D POP BC        ; Copy number of sprites above 4 bytes
 $AD3E LDIR          ;
 $AD40 LD HL,$71A3   ; From buffer to end of allocation table
 $AD43 LD BC,$0002   ; Copy 2 bytes
 $AD46 LDIR          ;
 $AD48 RET           ;

; Allocate sprite (RST $28)
;
; Used by the routine at #R$8018.
;
; O:IX holds sprite address
@label=allocate_sprite
c$AD49 PUSH HL       ;
 $AD4A PUSH DE       ;
 $AD4B PUSH BC       ;
 $AD4C LD HL,$7002   ; Address of sprite data
 $AD4F LD DE,$000C   ; Size of each sprite
 $AD52 LD BC,$2000   ; Number of sprites and sprite index
 $AD55 LD A,$7E      ;
*$AD57 CP (HL)       ;
 $AD58 JR C,$AD64    ; If > $7E (usually $FF), sprite is available
 $AD5A INC C         ; Sprite index++
 $AD5B ADD HL,DE     ; Advance to next sprite
 $AD5C DJNZ $AD57    ; Loop for up to 32 sprites
 $AD5E LD IX,$03E8   ; Not found, set to address in ROM (?)
 $AD62 JR $AD87      ; And return

; Routine at AD64
;
; Used by the routine at #R$AD49.
@label=available_sprite_found
c$AD64 PUSH HL         ; Save sprite address
 $AD65 BIT 7,(HL)      ;
 $AD67 JR Z,$AD75      ;
 $AD69 LD HL,$7182     ; Allocated sprites
 $AD6C INC (HL)        ; Record one more
 $AD6D LD A,(HL)       ; Read number back
 $AD6E ADD A,L         ; Add number to HL
 $AD6F LD L,A          ;
 $AD70 JP NC,$AD74     ;
 $AD73 INC H           ;
*$AD74 LD (HL),C       ; Record sprite index in table
*$AD75 POP IX          ; IX now holds sprite address
 $AD77 LD (IX+$07),$00 ; Init sprite
 $AD7B LD (IX+$03),$00 ;
 $AD7F LD (IX+$04),$FF ;
 $AD83 LD (IX+$08),$F8 ; Set y
; This entry point is used by the routine at #R$AD49.
*$AD87 POP BC          ;
 $AD88 POP DE          ;
 $AD89 POP HL          ;
 $AD8A RET             ;

; Load sprite pattern (RST $30)
;
; Used by the routine at #R$801B.
;
; I:IX Pointer to sprite data
@label=load_sprite_pattern
c$AD8B PUSH HL       ;
 $AD8C PUSH DE       ;
 $AD8D PUSH BC       ;
 $AD8E PUSH IY       ;
 $AD90 LD E,(IX+$00) ; Get sprite type
 $AD93 LD D,$00      ;
 $AD95 LD HL,$B8DD   ; Table of 29 bytes (offsets into table at $B8FA)
 $AD98 ADD HL,DE     ;
 $AD99 LD E,(HL)     ; Get graphics pointer offset for sprite type
 $AD9A LD HL,$B8FA   ; Table of pointers to graphics
 $AD9D ADD HL,DE     ; HL now pointer to graphics pointer
 $AD9E LD A,(IX+$01) ; Get which transformation we want (flipped, shifted,
                     ; etc.)
 $ADA1 LD DE,$0000   ; Address
 $ADA4 BIT 7,A       ; If bit 7 of transformation is set, skip ahead with E=0
 $ADA6 JR NZ,$ADB7   ;
 $ADA8 CP $15        ;
 $ADAA JR C,$ADB7    ; Jump if < $15
 $ADAC INC E         ; E = 1
 $ADAD CP $1A        ;
 $ADAF JR C,$ADB7    ; Jump if < $1A
 $ADB1 INC E         ; E = 2
 $ADB2 CP $22        ;
 $ADB4 JR C,$ADB7    ; Jump if < $22
 $ADB6 INC E         ; E = 3
*$ADB7 LD A,E        ;
 $ADB8 CP (HL)       ;
 $ADB9 JR C,$ADBD    ; Jump if LSB of pointer >= E, which is 0..3
 $ADBB LD A,(HL)     ; Get LSB of pointer
 $ADBC DEC A         ; Minus 1
*$ADBD INC HL        ; To MSB
 $ADBE LD B,(HL)     ; B = MSB
 $ADBF LD C,A        ; C = LSB - 1
 $ADC0 LD A,(IX+$02) ;
 $ADC3 ADD A,$02     ;
 $ADC5 AND $3F       ;
 $ADC7 LD (IX+$05),A ;
 $ADCA INC B         ;
 $ADCB DEC B         ;
 $ADCC JR NZ,$ADD1   ;
 $ADCE XOR A         ;
 $ADCF JR $ADD7      ;
*$ADD1 SRL A         ;
 $ADD3 DJNZ $ADD1    ;
 $ADD5 ADD A,A       ;
 $ADD6 ADD A,A       ;
*$ADD7 ADD A,C       ;
 $ADD8 LD B,A        ;
 $ADD9 CP (IX+$04)   ;
 $ADDC JR Z,$AE11    ;
 $ADDE LD (IX+$04),A ;
 $ADE1 LD L,(IX+$00) ; Sprite type
 $ADE4 LD H,$00      ;
 $ADE6 ADD HL,HL     ; * 2
 $ADE7 LD DE,$72E0   ;
 $ADEA ADD HL,DE     ; #R$72E0 + sprite type * 2
 $ADEB LD E,(HL)     ; Get LSB of VDP address
 $ADEC INC HL        ; TO MSB
 $ADED LD D,(HL)     ; Get MSB of VDP address
 $ADEE LD L,B        ; B must be index of pattern to fetch within sprite type.
 $ADEF LD H,$00      ;
 $ADF1 ADD HL,HL     ; Multiply by 8
 $ADF2 ADD HL,HL     ; ...
 $ADF3 ADD HL,HL     ; ...
 $ADF4 ADD HL,DE     ; And add DE
 $ADF5 EX DE,HL      ; Move HL into DE, which becomes source address
 $ADF6 LD HL,$71A3   ; Buffer
 $ADF9 LD BC,$0008   ; Read 8 bytes
 $ADFC CALL $1FE2    ; READ_VRAM
 $ADFF LD A,(IX+$0A) ; Get pattern
 $AE02 ADD A,A       ; Multiply by 8
 $AE03 ADD A,A       ; ...
 $AE04 ADD A,A       ; ...
 $AE05 LD E,A        ; ...
 $AE06 LD D,$08      ; DE = $800 + pattern * 8
 $AE08 LD HL,$71A3   ; Source
 $AE0B LD BC,$0008   ; Write 8 bytes
 $AE0E CALL $1FDF    ; WRITE_VRAM
*$AE11 LD A,(IX+$00) ; Get sprite type
 $AE14 CP $01        ; If 1, i.e. ship 2
 $AE16 JR Z,$AE2B    ; then skip ahead
 $AE18 LD D,(IX+$01) ; Polar y
 $AE1B LD E,(IX+$02) ; Polar x
 $AE1E CALL $B1C6    ; Polar to screen
 $AE21 LD (IX+$08),D ; Set y
 $AE24 LD (IX+$09),E ; Set x
 $AE27 JR C,$AE54    ; If carry, sprite is outside visible screen, skip ahead
 $AE29 JR $AE4E      ; Return
*$AE2B LD HL,$AFDD   ; If sprite type is ship 2, set HL to table address
 $AE2E LD A,(IX+$04) ;
 $AE31 AND $03       ;
 $AE33 JR NZ,$AE3F   ;
 $AE35 LD A,(IX+$05) ;
 $AE38 RRA           ;
 $AE39 AND $1E       ;
 $AE3B LD HL,$AFDF   ; Start at #R$AFDD+2
 $AE3E RST $08       ; Add A to HL
*$AE3F LD A,($700A)  ; Ship screen y
 $AE42 ADD A,(HL)    ; Add table value
 $AE43 LD (IX+$08),A ; Set y
 $AE46 INC HL        ; Next table address
 $AE47 LD A,($700B)  ; Ship screen x
 $AE4A ADD A,(HL)    ; Add table value
 $AE4B LD (IX+$09),A ; Set x
; This entry point is used by the routines at #R$AE54 and #R$AE75.
*$AE4E POP IY        ;
 $AE50 POP BC        ;
 $AE51 POP DE        ;
 $AE52 POP HL        ;
 $AE53 RET           ;

; Routine at AE54
;
; Used by the routine at #R$ADD1.
c$AE54 LD A,(IX+$00) ; Get sprite type
 $AE57 CP $0C        ; Jump if < 12
 $AE59 JR C,$AE86    ; ...
 $AE5B CP $0E        ; Jump if < 14
 $AE5D JR C,$AE67    ; ...
 $AE5F CP $12        ; Jump if < 18
 $AE61 JR C,$AE4E    ; ...
 $AE63 CP $18        ; Jump if >= 24
 $AE65 JR NC,$AE4E   ; ...
*$AE67 CP $12        ; Jump if < 18
 $AE69 JR C,$AE75    ; ...
 $AE6B CP $14        ; Jump if >= 20
 $AE6D JR NC,$AE75   ; ...
 $AE6F LD HL,$7252   ;
 $AE72 DEC (HL)      ;
 $AE73 JR $AE86      ; Set off-screen values and return

; Routine at AE75
;
; Used by the routine at #R$AE54.
c$AE75 LD HL,$7206     ;
 $AE78 DEC (HL)        ;
 $AE79 CP $15          ;
 $AE7B JR C,$AE86      ;
 $AE7D CP $18          ;
 $AE7F JR NC,$AE86     ;
 $AE81 LD HL,$7256     ;
 $AE84 RES 3,(HL)      ;
; This entry point is used by the routine at #R$AE54.
*$AE86 LD (IX+$00),$7F ;
 $AE8A LD (IX+$09),$00 ; Set x
 $AE8E LD (IX+$08),$F8 ; Set y
 $AE92 JR $AE4E        ;

; Upload sprite patterns
;
; Fill VDP RAM from $2100 to $3868 with sprite patterns that may be flipped and
; shifted. One new pattern is generated with each call. Builds a table of VDP
; addresses in #R$72E0. Used by the routine at #R$90D6.
@label=upload_sprite_patterns
c$AE94 LD A,($72D5)   ; Get counter
 $AE97 CP $FF         ; If maxed out
 $AE99 RET Z          ; Then return
 $AE9A LD HL,($72D8)  ; Get word (only used locally)
 $AE9D LD A,H         ; Is it zero?
 $AE9E OR L           ;
 $AE9F JR NZ,$AEAD    ; No - skip ahead
 $AEA1 LD HL,$2100    ; Yes - set it to $2100
 $AEA4 LD ($72D8),HL  ;
 $AEA7 LD HL,$72E0    ; Set another word to $72E0 (pointer to a RAM block)
 $AEAA LD ($72DC),HL  ;
*$AEAD LD A,($72D6)   ; Get counter
 $AEB0 LD HL,$72D7    ; And next counter
 $AEB3 OR (HL)        ;
 $AEB4 JR NZ,$AEC4    ; If any is non-zero skip ahead
 $AEB6 LD HL,($72DC)  ; HL = $72E0
 $AEB9 LD DE,($72D8)  ; DE = $2100 initially
 $AEBD LD (HL),E      ; Write $00
 $AEBE INC HL         ;
 $AEBF LD (HL),D      ; Write $21
 $AEC0 INC HL         ;
 $AEC1 LD ($72DC),HL  ; Save updated pointer, e.g. $72E0
*$AEC4 LD A,($72D5)   ; Get counter
 $AEC7 LD HL,$B8DD    ; Table of 29 bytes (offsets into table at $B8FA)
 $AECA RST $08        ; Add A to HL
 $AECB LD E,(HL)      ; Load DE with value from table
 $AECC LD D,$00       ;
 $AECE LD HL,$B8FA    ; Table of pointers to graphics
 $AED1 ADD HL,DE      ; Add offset
 $AED2 LD ($72DA),HL  ; Save address of pointer
 $AED5 LD A,($72D7)   ; Get counter
 $AED8 INC A          ; Increment
 $AED9 ADD A,A        ; Double
 $AEDA RST $08        ; Add A to HL
 $AEDB LD E,(HL)      ; Get LSB of pointer
 $AEDC INC HL         ;
 $AEDD LD D,(HL)      ; Get MSB of pointer
 $AEDE EX DE,HL       ; Now HL pointer to graphics
 $AEDF LD A,($72D6)   ; Get counter
 $AEE2 AND $03        ; 0, 1, 2, 3
 $AEE4 ADD A,A        ; 0, 2, 4, 6
 $AEE5 ADD A,A        ; 0, 4, 8, 12
 $AEE6 ADD A,A        ; 0, 8, 16, 32
 $AEE7 RST $08        ; Add A to HL
 $AEE8 LD DE,$71A3    ; Buffer
 $AEEB LD ($72DE),DE  ; Store as source address
 $AEEF LD BC,$0008    ; Copy 8 bytes
 $AEF2 LDIR           ; of graphics data info buffer
 $AEF4 LD HL,($72DA)  ; Get address of graphics pointer
 $AEF7 INC HL         ; To MSB
 $AEF8 LD A,(HL)      ; Get MSB
 $AEF9 OR A           ; Is it 0, i.e. not a real address?
 $AEFA JR Z,$AF15     ; Then skip ahead
 $AEFC LD IX,$72D6    ; Address of counter
 $AF00 BIT 2,(IX+$00) ; Is bit 2 set?
 $AF04 JR Z,$AF09     ; If not, skip ahead
 $AF06 CALL $AF6B     ; flip_horz
*$AF09 BIT 3,(IX+$00) ; Is bit 3 set?
 $AF0D JR NZ,$AF15    ; If not, skip ahead
 $AF0F CALL $AFAE     ; flip_vert
 $AF12 CALL $AFC2     ; shift_left
*$AF15 LD HL,($72DE)  ; Source for writing to VDP RAM
 $AF18 LD DE,($72D8)  ; Destination
 $AF1C LD BC,$0008    ; 8 bytes
 $AF1F CALL $1FDF     ; WRITE_VRAM
 $AF22 LD HL,($72D8)  ; Get destination address
 $AF25 LD BC,$0008    ;
 $AF28 ADD HL,BC      ; Add 8
 $AF29 LD ($72D8),HL  ; Write back
@label=inc_counters_1
 $AF2C LD IX,($72DA)  ; Get address of graphics pointer
 $AF30 LD A,($72D7)   ; Get counter
 $AF33 INC A          ; Increment it
 $AF34 CP (IX+$00)    ; When it reaches LSB of graphics pointer
 $AF37 JR NC,$AF3E    ; Then increment other counters
 $AF39 LD ($72D7),A   ; Otherwise store new value
 $AF3C SCF            ; Set carry flag
 $AF3D RET            ;
@label=inc_counters_2
*$AF3E XOR A          ;
 $AF3F LD ($72D7),A   ; Set counter at $72D7 to zero
 $AF42 LD A,(IX+$01)  ; Get MSB of graphics pointer
 $AF45 OR A           ; If zero
 $AF46 JR Z,$AF55     ; Then increment other counters
 $AF48 LD A,($72D6)   ; Get counter
 $AF4B INC A          ; Increment it
 $AF4C CP $10         ; When it reaches 10
 $AF4E JR NC,$AF55    ; Then increment other counters
 $AF50 LD ($72D6),A   ; Otherwise store new value
 $AF53 SCF            ; Set carry flag
 $AF54 RET            ;
@label=inc_counters_3
*$AF55 XOR A          ;
 $AF56 LD ($72D6),A   ; Set counter at $72D6 to zero
 $AF59 LD A,($72D5)   ; Increment counter at $72D5
 $AF5C INC A          ;
 $AF5D LD ($72D5),A   ; Get counter
 $AF60 LD HL,$001D    ;
 $AF63 CP L           ; When it reaches $1D (29)
 $AF64 RET C          ; ...
 $AF65 LD A,$FF       ; Then set it to $FF (done)
 $AF67 LD ($72D5),A   ; ...
 $AF6A RET            ;

; Take 8 bytes pointed to by $72DE and place them after, bit reversed. Returns
; address of reversed bytes in $72DE.
;
; Used by the routine at #R$AE94.
@label=flip_horz
c$AF6B LD HL,($72DE) ;
 $AF6E PUSH HL       ;
 $AF6F POP IY        ;
 $AF71 LD DE,$0008   ;
 $AF74 ADD HL,DE     ;
 $AF75 LD ($72DE),HL ;
 $AF78 LD B,$08      ;
*$AF7A RL (IY+$00)   ;
 $AF7E RR (HL)       ;
 $AF80 RL (IY+$01)   ;
 $AF84 RR (HL)       ;
 $AF86 RL (IY+$02)   ;
 $AF8A RR (HL)       ;
 $AF8C RL (IY+$03)   ;
 $AF90 RR (HL)       ;
 $AF92 RL (IY+$04)   ;
 $AF96 RR (HL)       ;
 $AF98 RL (IY+$05)   ;
 $AF9C RR (HL)       ;
 $AF9E RL (IY+$06)   ;
 $AFA2 RR (HL)       ;
 $AFA4 RL (IY+$07)   ;
 $AFA8 RR (HL)       ;
 $AFAA INC HL        ;
 $AFAB DJNZ $AF7A    ;
 $AFAD RET           ;

; Take 8 bytes pointed to by $72DE and place them after in reverse order.
; Returns address of reversed bytes in $72DE.
;
; Used by the routine at #R$AE94.
@label=flip_vert
c$AFAE LD DE,($72DE) ;
 $AFB2 LD HL,$0010   ;
 $AFB5 ADD HL,DE     ;
 $AFB6 LD B,$08      ;
*$AFB8 LD A,(DE)     ;
 $AFB9 DEC HL        ;
 $AFBA LD (HL),A     ;
 $AFBB INC DE        ;
 $AFBC DJNZ $AFB8    ;
 $AFBE LD ($72DE),HL ;
 $AFC1 RET           ;

; Take 8 bytes pointed to by $72DE and place them after, left shifted one bit.
; Returns address of shifted bytes in $72DE.
;
; Used by the routine at #R$AE94.
@label=shift_left
c$AFC2 LD DE,($72DE) ;
 $AFC6 LD HL,$0008   ;
 $AFC9 ADD HL,DE     ;
 $AFCA LD ($72DE),HL ;
 $AFCD EX DE,HL      ;
 $AFCE LD B,$08      ;
*$AFD0 LD A,$80      ;
*$AFD2 RL (HL)       ;
 $AFD4 RRA           ;
 $AFD5 JR NC,$AFD2   ;
 $AFD7 LD (DE),A     ;
 $AFD8 INC DE        ;
 $AFD9 INC HL        ;
 $AFDA DJNZ $AFD0    ;
 $AFDC RET           ;

; Table at AFDD
@label=table_at_AFDD
b$AFDD DEFB $00,$00,$08,$00,$06,$FF,$06,$FB
 $AFE5 DEFB $05,$FB,$00,$F9,$FF,$FA,$FB,$FB
 $AFED DEFB $FC,$FB,$F9,$00,$FA,$01,$FB,$05
 $AFF5 DEFB $FB,$05,$00,$07,$01,$05,$05,$05
 $AFFD DEFB $05,$06

; Display stars
;
; Used by the routines at #R$8024, #R$8139, #R$8170, #R$832A, #R$8368, #R$846B,
; #R$90D6, #R$A33B and #R$A3E1.
@label=display_stars
c$AFFF LD HL,$71EC   ; Counter from 7 to 0
 $B002 DEC (HL)      ; Count down
 $B003 RET P         ; Return
 $B004 LD (HL),$07   ; Reset counter to 7
 $B006 LD A,($71EB)  ; Get some flag
 $B009 BIT 0,A       ; Test bit 0
 $B00B JR Z,$B00F    ;
 $B00D LD (HL),$03   ; If bit 0 is set then reset counter to 3
*$B00F LD C,$00      ; Set mask to undraw
 $B011 CALL $B023    ;
 $B014 LD A,($731A)  ; Get star frame
 $B017 ADD A,$02     ; Add 2
 $B019 CP $0C        ; < 12 ?
 $B01B JR C,$B01E    ; Yes, skip ahead
 $B01D XOR A         ;
*$B01E LD ($731A),A  ; Set star frame to zero
 $B021 LD C,$FF      ; Set mask to draw

; Display star frame
;
; Used by the routine at #R$AFFF.
;
; I:C Mask $00 or $FF
@label=display_star_frame
c$B023 LD A,($731A)  ; 0, 2, 4, 6, 8, 10
 $B026 LD HL,$B04F   ; Table of pointers
 $B029 RST $08       ; Add A to HL
 $B02A LD E,(HL)     ; Get LSB
 $B02B INC HL        ;
 $B02C LD D,(HL)     ; Get MSB
 $B02D LD HL,($73F6) ; Get VDP address (always 0)
 $B030 EX DE,HL      ; Now HL holds address of star frame table to use
*$B031 LD A,(HL)     ; Get byte from table
 $B032 OR A          ;
 $B033 RET Z         ; Zero terminates
 $B034 JP M,$B046    ; If bit 7 is set it's a change of VDP address
 $B037 CALL $9AD0    ; vdp_read_byte from DE
 $B03A CP $18        ; >= 18
 $B03C JR NC,$B041   ; Then skip writing
 $B03E LD A,(HL)     ; Get byte from table
 $B03F AND C         ; Apply mask
 $B040 RST $10       ; Write VDP byte A to DE
*$B041 INC DE        ; Next VDP address
*$B042 INC HL        ; Next table address
 $B043 JP $B031      ; Loop
*$B046 AND $7F       ; Reset bit 7
 $B048 ADD A,E       ; Add VDP address LSB
 $B049 LD E,A        ; Write back to E
 $B04A JR NC,$B042   ; Loop if no carry
 $B04C INC D         ; Increment MSB if carry
 $B04D JR $B042      ; Loop

