; Sprite data (32 sprites)
;
; #TABLE(default, default)
; { =h Byte offset | =h Purpose }
; { $00 | Sprite type, or $FF if not allocated }
; { $01 | Polar y (depth, 0 is closest (normal ship position), 116 is furthest
; away) }
; { $02 | Polar x (angle, 0 at bottom center, moving clockwise to 16 at the
; left side, 32 at the top, and 48 at the right side) }
; { $03 | Close to polar y ($01) }
; { $04 | Close to polar x ($02) }
; { $05 | Close to polar x ($02) }
; { $06 | Unknown }
; { $07 | Unknown }
; { $08 | Screen y }
; { $09 | Screen x }
; { $0A | Pattern }
; { $0B | Color }
; TABLE#
; .
; #TABLE(default, default)
; { =h Sprite type | =h Description }
; { $00 | Ship 1 }
; { $01 | Ship 2 }
; { $02 | Shot }
; { $0D | Explosion dot }
