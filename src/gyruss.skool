; Display planet
;
; Used by the routines at #R$8368, #R$83D0 and #R$90D6.
;
; I:A Index of planet (1 based)
@label=display_planet
c$9175 ADD A,A       ; a *= 2
 $9176 JR Z,$91A1    ; If zero then undraw planet
 $9178 LD HL,$9396   ; Planet table minus 2: #R$9398-2
 $917B RST $08       ; Add A to HL
 $917C LD E,(HL)     ; Get LSB of planet data
 $917D INC HL        ;
 $917E LD D,(HL)     ; Get MSB of planet data
 $917F EX DE,HL      ; Address now in HL
 $9180 CALL $91B4    ; Draw to name table
 $9183 CALL $91CC    ;
 $9186 LD HL,$0400   ;
 $9189 CALL $9285    ;
 $918C LD HL,$96EE   ; Planet colors
 $918F LD DE,$2010   ; Address in color table
 $9192 LD BC,$0010   ; 16 color sets
 $9195 RST $38       ; WRITE_VRAM
 $9196 LD DE,$0900   ; Address in sprite pattern table
 $9199 LD HL,$96FE   ; Sprite patterns
 $919C LD BC,$0098   ; 19 patterns
 $919F RST $38       ; WRITE_VRAM
 $91A0 RET           ;

; Routine at 91A1
;
; Used by the routine at #R$9175.
c$91A1 CALL $920D    ; Clear row 7
 $91A4 LD HL,$71A3   ; Clear 16 bytes in RAM
 $91A7 LD DE,$71A4   ;
 $91AA LD BC,$000F   ;
 $91AD LD (HL),$00   ;
 $91AF LDIR          ;
 $91B1 LD HL,$71A3   ; Use cleared bytes as planet data
; This entry point is used by the routine at #R$9175.
@label=display_planet_name_table
*$91B4 LD DE,$194E   ; Address in name table
 $91B7 LD C,$04      ; 4 rows
*$91B9 LD B,$04      ; 4 columns
*$91BB LD A,(HL)     ; Get name to write
 $91BC RST $10       ; Write VDP byte
 $91BD INC DE        ; Next destination
 $91BE INC HL        ; Next source
 $91BF DJNZ $91BB    ; Loop for 4 columns
 $91C1 PUSH HL       ; Save source
 $91C2 LD HL,$001C   ; 32 - 4
 $91C5 ADD HL,DE     ; One row down
 $91C6 EX DE,HL      ; To DE
 $91C7 POP HL        ; Restore source
 $91C8 DEC C         ; Row counter
 $91C9 JR NZ,$91B9   ; Loop for 4 rows
 $91CB RET           ;

; Display planet name and sprites
;
; Used by the routine at #R$9175.
;
; I:HL Address of planet name prefixed by length
@label=display_planet_name_and_sprites
c$91CC PUSH HL         ; Save address
 $91CD CALL $920D      ; clear_row_7
 $91D0 LD A,$20        ; 32
 $91D2 SUB (HL)        ; 32 - length
 $91D3 SRL A           ; (32 - length) / 2
 $91D5 LD DE,$18E0     ; Name table address of row
 $91D8 EX DE,HL        ;
 $91D9 RST $08         ; Add A to HL
 $91DA EX DE,HL        ; DE = display address
 $91DB LD C,(HL)       ; Get length
 $91DC LD B,$00        ;
 $91DE INC HL          ; Advance source to text
 $91DF RST $38         ; WRITE_VRAM
 $91E0 POP HL          ; Restore address
 $91E1 LD A,(HL)       ; Get length
 $91E2 INC A           ; Length + 1
 $91E3 RST $08         ; Add A to HL. Now HL points after text.
 $91E4 LD B,(HL)       ; Get number of sprites
 $91E5 INC HL          ; Next source byte
 $91E6 LD C,(HL)       ; Get color
 $91E7 INC HL          ; Next source byte
 $91E8 LD A,(HL)       ; Get pattern?
 $91E9 ADD A,$20       ; Add 32
 $91EB LD E,A          ; Store in E
 $91EC INC HL          ; Next source byte
*$91ED RST $28         ; Allocate sprite
 $91EE LD (IX+$00),$00 ; Mark as allocated (set type)
 $91F2 LD A,(HL)       ; Get y
 $91F3 LD D,A          ; Store in D
 $91F4 AND $7F         ; Only use 7 bits of y
 $91F6 LD (IX+$08),A   ; Set y
 $91F9 INC HL          ; Next source byte
 $91FA LD A,(HL)       ; Get x
 $91FB LD (IX+$09),A   ; Set x
 $91FE INC HL          ; Next source byte
 $91FF LD (IX+$0A),E   ; Set pattern
 $9202 LD (IX+$0B),C   ; Set color
 $9205 BIT 7,D         ; If bit 7 of y is set
 $9207 JR NZ,$920A     ; Then skip
 $9209 INC E           ; Else increment pattern
*$920A DJNZ $91ED      ; Loop to next sprite
 $920C RET             ;

; Clear name table row 7
;
; Used by the routines at #R$8368, #R$90D6, #R$91A1 and #R$91CC.
@label=clear_row_7
c$920D PUSH HL       ;
 $920E PUSH DE       ;
 $920F PUSH BC       ;
 $9210 LD A,$00      ; Space
 $9212 LD HL,$18E0   ; Address in name table (row 7)
 $9215 LD DE,$0020   ; 32 bytes
 $9218 CALL $1F82    ; FILL_VRAM
 $921B POP BC        ;
 $921C POP DE        ;
 $921D POP HL        ;
 $921E RET           ;

; Decode and upload patterns to VDP buffer at $1400
;
; Used by the routine at #R$90D6.
@decode_and_upload_patterns
c$921F LD HL,$0279   ; Number of bytes in block at $9475
 $9222 LD ($726A),HL ; Save it
 $9225 XOR A         ; A = 0
 $9226 LD ($726C),A  ; Save it
 $9229 LD HL,$9474   ; Source address - 1
 $922C LD DE,$1400   ; Destination address in VDP RAM
; This entry point is used by the routine at #R$924E.
*$922F LD A,($726B)  ; MSB of counter
 $9232 OR A          ; Test MSB
 $9233 RET M         ; Return when MSB is negative
 $9234 LD B,$01      ; Read 1 bit
 $9236 CALL $9257    ; Read it into A
 $9239 OR A          ; If zero, write multiple bytes
 $923A JR NZ,$924E   ; Otherwise jump to write a single byte
 $923C LD B,$05      ; Read 5 bits
 $923E CALL $9257    ; Read them into A
 $9241 ADD A,$02     ; Add 2 as the base
 $9243 PUSH AF       ; Save number of repeats
 $9244 CALL $9255    ; Get byte to write in A
 $9247 POP BC        ; Restore number of repeats
*$9248 RST $10       ; Write VDP byte in A to DE
 $9249 INC DE        ; Next VDP address
 $924A DJNZ $9248    ; Loop B times
 $924C JR $922F      ; Loop

; Write single byte
;
; Used by the routine at #R$921F.
c$924E CALL $9255    ; Get byte to write
 $9251 RST $10       ; Write VDP byte in A to DE
 $9252 INC DE        ; Next VDP address
 $9253 JR $922F      ; Loop

; Read B bits into A
;
; Used by the routines at #R$921F and #R$924E.
@read_b_bits_into_a
c$9255 LD B,$08      ; Read 8 bits
; This entry point is used by the routine at #R$921F.
*$9257 XOR A         ; Result
*$9258 PUSH BC       ; Push number of bits to read
 $9259 PUSH AF       ; Push result
 $925A LD A,($726C)  ; Number of bits left in current byte
 $925D DEC A         ; Decrement
 $925E JP P,$9271    ; Skip ahead if there are still bits left
 $9261 INC HL        ; Increment source address
 $9262 LD A,(HL)     ; get source byte
 $9263 LD ($726D),A  ; Save source byte
 $9266 LD BC,($726A) ; Byte counter
 $926A DEC BC        ; Decrement
 $926B LD ($726A),BC ; And save
 $926F LD A,$07      ; 8 bits - 1 left
*$9271 LD ($726C),A  ; Save bits left
 $9274 LD A,($726D)  ; Get source byte
 $9277 RLA           ; Rotate left through carry
 $9278 LD ($726D),A  ; Save again
 $927B RL B          ; Rotate carry into bite 0
 $927D POP AF        ; Pop result
 $927E RR B          ; Rotate bit 0 into carry
 $9280 RLA           ; Rotate carry into result
 $9281 POP BC        ; Pop number of bits to read
 $9282 DJNZ $9258    ; Repeat for n bits
 $9284 RET           ;

; Copy 135 patterns from VDP RAM buffer into pattern table from 128
;
; Used by the routine at #R$9175.
;
; I:HL Pattern generator table destination address ($0400)
c$9285 LD DE,$1400   ;
 $9288 LD B,$0E      ; Counter
*$928A PUSH BC       ;
 $928B PUSH DE       ;
 $928C PUSH HL       ;
 $928D LD BC,$0048   ; Read 9 patterns from $1400 (?)
 $9290 LD HL,$71A3   ; Into buffer
 $9293 CALL $1FE2    ; READ_VRAM
 $9296 POP DE        ; DE = $0400
 $9297 PUSH DE       ;
 $9298 LD BC,$0048   ; Write 9 patterns from buffer
 $929B LD HL,$71A3   ; To $0400 (pattern 128)
 $929E RST $38       ; WRITE_VRAM
 $929F POP HL        ; HL = $0400
 $92A0 LD BC,$0048   ;
 $92A3 ADD HL,BC     ; Advance 9 patterns, HL = $0448
 $92A4 POP DE        ; DE = $1400
 $92A5 EX DE,HL      ;
 $92A6 ADD HL,BC     ;
 $92A7 EX DE,HL      ; DE = $1448
 $92A8 POP BC        ;
 $92A9 DJNZ $928A    ; Loop 15 times = 135 patterns
 $92AB RET           ;

