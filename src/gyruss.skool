 $8530 SET 0,(HL)    ;
 $8532 POP AF        ;
 $8533 POP BC        ;
 $8534 POP DE        ;
 $8535 POP HL        ;
 $8536 POP IY        ;
 $8538 POP IX        ;
 $853A RETN          ;

