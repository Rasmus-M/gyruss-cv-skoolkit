; ROM header
b$8000 DEFB $55,$AA

; Pointer to sprite name table
w$8002 DEFW $0000

; Pointer to sprite order table
w$8004 DEFW $7183

; Pointer to temporary storage in RAM
w$8006 DEFW $71A3

; Pointer to controller memory map
w$8008 DEFW $0000

; Pointer to start address
w$800A DEFW $8024

; RST $08
c$800C JP $9AB3      ; Add A to HL

; RST $10
c$800F JP $9AC3      ; Write VDP byte (DE = address, A = value)

; RST $18
c$8012 JP $1FD9      ; WRITE_REGISTER (B = reg, C = value)

; RST $20
c$8015 JP $BFAE      ; Random number generator

; RST $28
c$8018 JP $AD49      ; Allocate_sprite

; RST $30
c$801B JP $AD8B      ; Load sprite pattern

; RST $38
c$801E JP $1FDF      ; WRITE_VRAM (HL = source, DE = dest, BC = count)

; NMI
c$8021 JP $8501      ; Interrupt routine

; Entry point
@label=entry
c$8024 LD SP,$73BA   ; Init stack pointer
 $8027 OUT ($C0),A   ; Controller enable
 $8029 LD HL,$7000   ; Clear RAM
 $802C LD DE,$7001   ; #R$7000+1
 $802F LD BC,$03B9   ; ...
 $8032 LD (HL),L     ; ...
 $8033 LDIR          ; ...
 $8035 LD HL,$8060   ; Set center of projection
 $8038 LD ($7000),HL ; ...
 $803B CALL $9ADE    ; Init sound
 $803E CALL $90D6    ; Start screen
 $8041 LD HL,$2A30   ; 180 * 60 frames
 $8044 LD ($7257),HL ; Set screensaver countdown
@label=entry_wait_fire
*$8047 HALT          ; Wait for interrupt
 $8048 CALL $AFFF    ;
 $804B LD HL,$0000   ; Controller 0, segment 0
 $804E CALL $1F79    ; DECODER
 $8051 BIT 6,H       ; Test fire
 $8053 JR NZ,$8064   ; Jump if fire pressed
 $8055 LD HL,$0100   ; Controller 1, segment 0
 $8058 CALL $1F79    ; DECODER
 $805B BIT 6,H       ; Test fire
 $805D JR Z,$8047    ; Loop until fire pressed
 $805F LD HL,$71EB   ; Set two player flag
 $8062 SET 7,(HL)    ; ...
; This entry point is used by the routine at #R$81ED. Fire pressed
@label=new_game
*$8064 LD HL,$0000   ;
 $8067 LD ($7257),HL ; Clear screensaver countdown
 $806A LD HL,$1800   ; Name table address
 $806D LD DE,$0300   ; Name table size
 $8070 XOR A         ; Zero
 $8071 CALL $1F82    ; FILL_VRAM (clear screen)
 $8074 LD HL,$201C   ; Last 4 bytes of color table
 $8077 LD DE,$0004   ; 4 bytes
 $807A LD A,$F1      ; Set to white/black
 $807C CALL $1F82    ; FILL_VRAM
 $807F LD HL,$71F1   ; Clear RAM  from $71F1
 $8082 LD DE,$71F2   ; To $7256
 $8085 XOR A         ; ...
 $8086 LD (HL),A     ; ...
 $8087 LD BC,$0065   ; ...
 $808A LDIR          ; ...
 $808C LD A,($71EB)  ; Clear all but two player flag
 $808F AND $80       ; ...
 $8091 LD ($71EB),A  ; ...
 $8094 LD A,$05      ; 5 Lives
 $8096 LD ($71FF),A  ; Set lives
 $8099 INC A         ; Increment to 6
 $809A LD ($71F8),A  ; Set #R$71F6+2 to 6 (extra life at 60000)
 $809D LD ($71FE),A  ; Set #R$71FC+2 to 6 (extra life at 60000)
 $80A0 LD A,$01      ; Stage
 $80A2 LD ($7200),A  ; Set to 1
 $80A5 CALL $AA7D    ;
 $80A8 LD HL,$853C   ; Display stage message
 $80AB LD DE,$1AF8   ; ...
 $80AE LD BC,$0005   ; ...
 $80B1 RST $38       ; WRITE_VRAM
 $80B2 LD DE,$1802   ; Display '1' at the top left corner
 $80B5 LD A,$31      ; ...
 $80B7 RST $10       ; Write VDP byte
 $80B8 INC DE        ; Display '-' next to '1'
 $80B9 LD A,$2D      ; ...
 $80BB RST $10       ; Write VDP byte
 $80BC XOR A         ; Parameter to display score
 $80BD CALL $A699    ; Display score player 1
 $80C0 LD A,($71EB)  ; Flags
 $80C3 BIT 7,A       ; Test bit for two players
 $80C5 JR Z,$80E0    ; If bit is reset then skip ahead
 $80C7 LD DE,$181E   ; Display '-' at the top right corner
 $80CA LD A,$2D      ; ...
 $80CC RST $10       ; Write VDP byte
 $80CD INC DE        ; Display '2' next to '-'
 $80CE LD A,$32      ; ...
 $80D0 RST $10       ; Write VDP byte
 $80D1 LD A,$01      ;
 $80D3 CALL $A699    ; Display score player 2
 $80D6 LD HL,$71FF   ; Save player data in VDP RAM, starting with lives?
 $80D9 LD DE,$1300   ; VDP address
 $80DC LD BC,$002D   ; 45 bytes
 $80DF RST $38       ; WRITE_VRAM
*$80E0 LD A,R        ; Random number seed
 $80E2 LD ($731C),A  ; Init random number
 $80E5 CALL $8212    ; Initialize stage

; Main loop
;
; Used by the routines at #R$81AE and #R$83D0.
@label=main_loop
c$80E8 LD HL,$725A   ; Flag set by interrupt routine
*$80EB BIT 0,(HL)    ; Test flag
 $80ED JR Z,$80EB    ; Wait until set
 $80EF RES 0,(HL)    ; Clear flag
 $80F1 CALL $1FDC    ; READ_REGISTER (read VDP status)
 $80F4 CALL $AFFF    ; Display stars
 $80F7 CALL $A73C    ; Control ship
 $80FA CALL $85E6    ;
 $80FD CALL $1FDC    ; READ_REGISTER
 $8100 CALL $9796    ;
 $8103 CALL $8E2D    ;
 $8106 CALL $1FDC    ; READ_REGISTER
 $8109 CALL $8BD9    ;
 $810C CALL $AAF1    ;
 $810F CALL $1FDC    ; READ_REGISTER
 $8112 CALL $8D50    ;
 $8115 CALL $84B1    ; Upload sprites
 $8118 CALL $AB72    ; Display center enemies
 $811B LD A,($71F1)  ; Current player
 $811E CALL $A699    ; Display score
 $8121 LD A,($71EB)  ; Status flags
 $8124 BIT 2,A       ; Test bit 2
 $8126 JP NZ,$8139   ; Exit main loop if set
 $8129 BIT 1,A       ; Test bit 1
 $812B JR Z,$80E8    ; Loop if not set
 $812D LD A,($7206)  ;
 $8130 LD HL,$7252   ;
 $8133 ADD A,(HL)    ;
 $8134 JP Z,$832A    ; Stage completed
 $8137 JR $80E8      ; Loop

; Exit from main loop after dying
;
; Used by the routine at #R$80E8.
@label=died
c$8139 CALL $9B87    ;
 $813C LD A,$03      ; Play explosion sound
 $813E CALL $9EA3    ; ...
 $8141 LD HL,$71EB   ; Reset main loop flag
 $8144 RES 6,(HL)    ; ...
 $8146 CALL $1FDC    ; READ_REGISTER
 $8149 CALL $8AE6    ; Update sprite types $0F - $11
 $814C CALL $A3E1    ; Explosion
@label=label_at_814F
*$814F LD A,($722C)  ;
 $8152 OR A          ;
 $8153 JR NZ,$815E   ;
 $8155 LD A,($7206)  ;
 $8158 LD HL,$722B   ;
 $815B CP (HL)       ;
 $815C JR Z,$8170    ;
*$815E HALT          ;
 $815F CALL $AFFF    ;
 $8162 CALL $85E6    ;
 $8165 CALL $8E2D    ;
 $8168 CALL $AB72    ; Display center enemies
 $816B CALL $84B1    ;
 $816E JR $814F      ;

; Routine at 8170
;
; Used by the routine at #R$8139.
c$8170 CALL $8D21    ;
 $8173 LD HL,$7204   ;
 $8176 INC (HL)      ;
 $8177 LD HL,$71FF   ; Lives
 $817A DEC (HL)      ; Lose life
 $817B JR NZ,$81AE   ; Jump if lives left
 $817D LD DE,$1C00   ;
 $8180 LD A,$D0      ;
 $8182 RST $10       ; Write VDP byte
 $8183 CALL $830E    ; Display player
 $8186 LD HL,$85DD   ;
 $8189 LD DE,$19CB   ;
 $818C LD BC,$0009   ;
 $818F RST $38       ; WRITE_VRAM
 $8190 LD B,$00      ;
*$8192 PUSH BC       ;
 $8193 HALT          ;
 $8194 CALL $AFFF    ;
 $8197 POP BC        ;
 $8198 DJNZ $8192    ;
 $819A CALL $84ED    ;
 $819D LD HL,$71EB   ;
 $81A0 BIT 7,(HL)    ; Test for two players
 $81A2 JP Z,$81ED    ;
 $81A5 BIT 5,(HL)    ;
 $81A7 JP NZ,$81ED   ;
 $81AA SET 5,(HL)    ;
 $81AC JR $81B9      ;

; Switch player
;
; Used by the routine at #R$8170.
@label=switch_player
c$81AE LD A,($71EB)  ; Test for two players
 $81B1 BIT 7,A       ; ...
 $81B3 JR Z,$81E2    ; Skip ahead if one player
 $81B5 BIT 5,(HL)    ; Test for ?
 $81B7 JR NZ,$81E2   ; Skip ahead if not set
; This entry point is used by the routine at #R$8170.
*$81B9 LD HL,$71A3   ; Restore player data from VDP RAM into buffer
 $81BC LD DE,$1300   ; ...
 $81BF LD BC,$002D   ; ...
 $81C2 CALL $1FE2    ; READ_VRAM
 $81C5 LD HL,$71FF   ; Save player data to VDP RAM
 $81C8 LD DE,$1300   ; ...
 $81CB LD BC,$002D   ; ...
 $81CE RST $38       ; WRITE_VRAM
 $81CF LD HL,$71A3   ; Copy data from buffer to right place
 $81D2 LD DE,$71FF   ; ...
 $81D5 LD BC,$002D   ; ...
 $81D8 LDIR          ; ...
 $81DA LD A,($71F1)  ; Current player
 $81DD XOR $01       ; Switch player
 $81DF LD ($71F1),A  ; Save again
*$81E2 CALL $8212    ; Initialize stage
 $81E5 LD HL,$7256   ;
 $81E8 SET 5,(HL)    ;
 $81EA JP $80E8      ; To main loop

; Routine at 81ED
;
; Used by the routine at #R$8170.
c$81ED LD HL,$4650   ; 300 frames
 $81F0 LD ($7257),HL ; Set screensaver countdown
*$81F3 HALT          ;
 $81F4 LD HL,$0001   ; Controller 0, segment 1
 $81F7 CALL $1F79    ; DECODER
 $81FA LD A,L        ;
 $81FB CP $0A        ;
 $81FD JP Z,$8064    ; Start a new game
 $8200 CP $0F        ;
 $8202 JP NZ,$0000   ; Reset
 $8205 LD HL,$0000   ; Controller 0, segment 0
 $8208 CALL $1F79    ; DECODER
 $820B BIT 6,H       ; Test fire
 $820D JP NZ,$8064   ; Start a new game
 $8210 JR $81F3      ; Loop

; Init stage
;
; Initializa stage and display X WARPS TO Y message Used by the routines at
; #R$8024, #R$81AE and #R$83D0.
@label=init_stage
c$8212 LD HL,$722E   ; Clear $28 bytes from $722E
 $8215 LD DE,$722F   ; ...
 $8218 LD BC,$0028   ; ...
 $821B LD (HL),$00   ; ...
 $821D LDIR          ; ...
 $821F LD A,$01      ;
 $8221 LD ($71EE),A  ;
 $8224 LD HL,$71EB   ; Clear flag that exists main loop
 $8227 RES 2,(HL)    ; ...
; Calculate stage data index
 $8229 LD A,($7205)  ; Get completed stages
 $822C OR A          ; Test if zero
 $822D JR NZ,$823E   ; If not, skip ahead to set max value
 $822F LD A,($7200)  ; Stage
 $8232 CP $04        ;
 $8234 JR NC,$8240   ; Jump if stage >= 4, to set value = stage / 4 + 1
 $8236 LD B,A        ; B = stage 1-3
 $8237 XOR A         ; A = 0
 $8238 DEC B         ; B = 0-2
 $8239 JR Z,$8245    ; If zero then skip ahead to save value
 $823B INC A         ; Stage = 2 or 3, set A = 1
 $823C JR $8245      ; Skip ahead to save value
*$823E LD A,$18      ; 24
*$8240 SRL A         ; Divide stage by 4
 $8242 SRL A         ; ...
 $8244 INC A         ; + 1
*$8245 LD ($7203),A  ; Save value (0 - 7)
; Display stage number
 $8248 LD A,($7200)  ; Current stage
 $824B LD HL,$7205   ; Completed stages
 $824E ADD A,(HL)    ; Add to stage
 $824F LD DE,$1AFE   ; VDP address (stage number tens)
 $8252 CP $0A        ;
 $8254 JR C,$8267    ; Jump if < 10
 $8256 LD B,$00      ; Divide by ten into B
*$8258 SUB $0A       ; ...
 $825A JR C,$825F    ; ...
 $825C INC B         ; ...
 $825D JR $8258      ; ...
*$825F ADD A,$0A     ; Restore ones
 $8261 LD C,A        ; Save in C
 $8262 LD A,B        ; Tens
 $8263 ADD A,$30     ; Add ASCII 0
 $8265 RST $10       ; Write VDP byte
 $8266 LD A,C        ; Ones
*$8267 INC DE        ; Increment VDP address to stage number ones
 $8268 ADD A,$30     ; Add ASCII 0
 $826A RST $10       ; Write VDP byte
; Display X WARPS TO Y message
 $826B LD A,($7201)  ; Check whether you just died
 $826E OR A          ; So we want to display READY instead
 $826F JR NZ,$82BA   ; And if so jump ahead
 $8271 LD A,($7200)  ; Get stage
 $8274 LD B,A        ; Save in B
 $8275 SRL A         ; Divide by 2
 $8277 AND $0E       ; Clamp to 0, 2, 4, 6, 8, 10, 12
 $8279 LD HL,$9398   ; Base planet table
 $827C RST $08       ; Add A to HL
 $827D LD E,(HL)     ; Get LSB of planet data
 $827E INC HL        ; To MSB
 $827F LD D,(HL)     ; Get MSB of planet data
 $8280 LD HL,$0010   ; Planet name offset is 16
 $8283 ADD HL,DE     ; Add planet data address
 $8284 PUSH HL       ; Save it
 $8285 LD DE,$71A4   ; Buffer address for the string #R$71A3+1
 $8288 LD A,B        ; Restore stage
 $8289 AND $03       ; Clamp to 0, 1, 2, 3 (0 not an option?)
 $828B CP $03        ; If 3 we have reached it's a chance stage
 $828D JR Z,$82BF    ; Then jump ahead
 $828F XOR $03       ; Flip the bits, so we know how many warps TO the planet
 $8291 ADD A,$30     ; Add ASCII 0
 $8293 LD (DE),A     ; Store number in the buffer
 $8294 INC DE        ; Next buffer address
 $8295 LD HL,$859C   ; WARPS message
 $8298 LD BC,$0005   ; Copy 5 bytes '_WARP'
 $829B CP $31        ; If the number is less than 2,
 $829D JR Z,$82A0    ; then skip ahead
 $829F INC BC        ; Otherwise copy one more byte '_WARPS'
*$82A0 LDIR          ; Make the copy
 $82A2 LD HL,$85A2   ; Copy _TO_ message
 $82A5 LD BC,$0004   ; 4 bytes
 $82A8 LDIR          ; Make the copy
 $82AA POP HL        ; Restore the planet name address
 $82AB LD C,(HL)     ; Get length of name
 $82AC INC HL        ; Next byte
 $82AD LDIR          ; Copy planet name
 $82AF EX DE,HL      ; Now HL=destination and DE=source
 $82B0 LD DE,$71A4   ; Buffer address for the string #R$71A3+1
 $82B3 SBC HL,DE     ; Now HL contain the length of the string
 $82B5 EX DE,HL      ; Now DE=length and HL=$71A4
 $82B6 DEC HL        ; HL=#R$71A3
 $82B7 LD (HL),E     ; Set length
 $82B8 JR $82C3      ; Jump ahead
*$82BA LD HL,$8589   ; Ready message
 $82BD JR $82C3      ; Skip ahead
*$82BF POP HL        ; Drop the pushed planet name address
 $82C0 LD HL,$858F   ; Chance stage message
*$82C3 LD A,$20      ; At this point HL contains a pointer to the length
                     ; prefixed message to print
 $82C5 SUB (HL)      ; 32 - string length
 $82C6 SRL A         ; / 2 = offset to center line
 $82C8 LD DE,$1A00   ; VDP address of line start
 $82CB ADD A,E       ; Add address to offset
 $82CC LD E,A        ; Copy back to destination
 $82CD LD C,(HL)     ; Length
 $82CE LD B,$00      ; MSB of length
 $82D0 INC HL        ; Increment source to text
 $82D1 RST $38       ; WRITE_VRAM Display the X WARPS TO Y message
; Display ship and stars with music for a short while
 $82D2 CALL $830E    ; Display player if 2 player
 $82D5 LD B,$00      ; For calculating ...
 $82D7 LD A,($7200)  ; Get stage
 $82DA LD HL,$7205   ; Add completed stages
 $82DD ADD A,(HL)    ; ...
 $82DE CP $01        ; If 1 then skip ahead with B = 0
 $82E0 JR Z,$82F6    ; ...
 $82E2 AND $03       ; Stage mod 4
 $82E4 LD B,$05      ; Set B = 5
 $82E6 CP $01        ; And skip ahead if stage mod 4 < 1
 $82E8 JR C,$82F6    ; ...
 $82EA LD B,$03      ; Set B = 3
 $82EC JR Z,$82F6    ; And skip ahead if stage mod 4 = 1
 $82EE LD B,$04      ; Set B = 4
 $82F0 CP $02        ; And skip ahead if stage mod 4 = 2
 $82F2 JR Z,$82F6    ; ...
 $82F4 LD B,$06      ; Set B = 6
*$82F6 LD A,B        ; Set A = B
 $82F7 CALL $9E91    ; Play selected tune
 $82FA CALL $A6D2    ; Display lives
 $82FD CALL $ACDF    ; Init sprite data
 $8300 CALL $A33B    ; Initial game loop
 $8303 CALL $8E8D    ; Init some variables
 $8306 LD HL,$71EB   ; Update status flags
 $8309 RES 4,(HL)    ; ...
 $830B SET 6,(HL)    ; Set main loop flag
 $830D RET           ;

; Display player message
;
; Used by the routines at #R$8170 and #R$82BF.
@label=display_player
c$830E LD A,($71EB)  ; Status
 $8311 BIT 7,A       ; Check bit for 2 players
 $8313 RET Z         ; Return if not set
 $8314 LD HL,$8581   ; PLAYER 1 message
 $8317 LD DE,$192C   ; VDP address
 $831A LD BC,$0008   ; 8 characters
 $831D RST $38       ; WRITE_VRAM
 $831E LD A,($71F1)  ; Current player
 $8321 OR A          ; Is it player 1?
 $8322 RET Z         ; The return
 $8323 LD A,$32      ; ASCII 2
 $8325 LD DE,$1933   ; VDP address
 $8328 RST $10       ; Write VDP byte
 $8329 RET           ;

