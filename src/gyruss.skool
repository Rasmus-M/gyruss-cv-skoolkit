; Interrupt routine
;
; Calls sound player and handles screen saver Used by the routine at #R$8021.
@label=interrupt_routine
c$8501 PUSH IX       ;
 $8503 PUSH IY       ;
 $8505 PUSH HL       ;
 $8506 PUSH DE       ;
 $8507 PUSH BC       ;
 $8508 PUSH AF       ;
 $8509 LD HL,($7257) ; Counter
 $850C LD A,H        ; Check if zero
 $850D OR L          ; ...
 $850E JR Z,$8522    ; If counter is 0 then skip ahead
 $8510 DEC HL        ; Otherwise decrement
 $8511 LD ($7257),HL ; and save.
 $8514 LD A,H        ; Check again if zero
 $8515 OR L          ; ...
 $8516 JR NZ,$8522   ; If not then skip ahead, otherwise blank screen
 $8518 LD BC,$0180   ; Display off, interrupt off
 $851B RST $18       ; WRITE_REGISTER
 $851C LD BC,$0701   ; Black border
 $851F RST $18       ; WRITE_REGISTER
*$8520 JR $8520      ; Loop
*$8522 CALL $9B99    ; Sound player
